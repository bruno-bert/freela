LOCAL_SESSION_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
FIREBASE_WEB_API_KEY=
# Live services are the default. API keys remain in ignored .env.local.
# GOOGLE_PLACES_API_KEY: server-only, restricted to Places API (New).
# GOOGLE_MAPS_BROWSER_KEY: browser/referrer restricted to the web origin.
# Firebase Admin uses Application Default Credentials, never a committed key.
# Run gcloud auth application-default login --project=freela-c8c75 locally.
# APP_ENV=test explicitly selects isolated fictional fixtures for automated tests.
