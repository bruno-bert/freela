              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 100,
                        "maximum": 50000
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude",
                      "radius"
                    ]
                  },
                  "category": {
                    "type": "string",
