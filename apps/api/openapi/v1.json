                      "all",
                      "car_repair",
                      "cafe",
                      "florist",
                      "store"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "all",
                      "new",
                      "contacted"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "all",
                      "whatsapp",
                      "instagram"
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "en",
                      "pt-BR"
                    ]
                  }
                },
                "required": [
                  "region",
                  "category",
                  "status",
                  "channel",
                  "locale"
                ]
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "companies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "address": {
                            "type": "string"
                          },
                          "phone": {
                            "nullable": true,
                            "type": "string"
                          },
                          "whatsapp": {
                            "nullable": true,
                            "type": "string"
                          },
                          "instagram": {
                            "nullable": true,
                            "type": "string"
                          },
                          "website": {
                            "nullable": true,
                            "type": "string"
                          },
                          "sourceUrl": {
                            "nullable": true,
                            "type": "string"
                          },
                          "location": {
                            "type": "object",
                            "properties": {
                              "latitude": {
                                "type": "number"
                              },
                              "longitude": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "latitude",
                              "longitude"
                            ],
                            "additionalProperties": false
                          },
                          "contact": {
                            "type": "object",
                            "properties": {
                              "contacted": {
                                "type": "boolean"
                              },
                              "version": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "history": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "at": {
                                      "type": "string"
                                    },
                                    "note": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "at",
                                    "note"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "contacted",
                              "version",
                              "history"
                            ],
                            "additionalProperties": false
                          },
                          "fictional": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "category",
                          "address",
                          "phone",
                          "whatsapp",
                          "instagram",
                          "website",
                          "sourceUrl",
                          "location",
                          "contact",
                          "fictional"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "provider": {
                      "type": "string",
                      "enum": [
                        "demo",
                        "google-places"
                      ]
                    },
                    "exhaustive": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "fetched": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "companies",
                    "provider",
                    "exhaustive",
                    "fetched"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
