{
  "name": "freelancer-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node scripts/coverage-reports.mjs",
    "test:e2e": "playwright test",
    "test:stories": "vitest run --config apps/storybook/vitest.config.ts",
    "changelog": "node packages/changelog/generate.mjs",
    "ci:quality": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm ci:coverage-new && pnpm ci:emulators && pnpm test:e2e && pnpm test:stories && pnpm build",
    "ci:coverage-new": "node scripts/check-new-coverage.mjs",
    "ci:emulators": "node scripts/emulators.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^6.0.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "firebase-tools": "^14.25.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "storybook": "10.6.7",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vitest": "5.1.0"
  }
}
