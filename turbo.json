{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "packages/core/src/**",
    "packages/design-system/src/**",
    "packages/config-tailwind/**",
    "scripts/build-api.mjs"
  ]
}
